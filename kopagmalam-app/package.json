{
  "name": "kopagmalam-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:android": "npm run build:android && cap sync android",
    "cap:studio": "npm run cap:sync:android && cap open android",
    "cap:android": "cap open android",
    "android": "npm run build && cap run android"
  },
  "dependencies": {
